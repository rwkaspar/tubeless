{
  "manifest_version": 3,
  "name": "Tubeless — YouTube ohne Ablenkung",
  "version": "1.0.0",
  "description": "Entfernt sämtliche Ablenkungen von YouTube: Feed, Sidebar, Shorts, Empfehlungen, Kommentare, Endcards, Autoplay und mehr.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tubeless",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["src/tubeless.css"],
      "js": ["src/features.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
